# LearnGo — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# Never commit .env. Only NEXT_PUBLIC_ vars reach the browser.

# Supabase — Dashboard → Project Settings → API Keys
# URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...). RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key (sb_secret_...). SERVER-SIDE ONLY, never prefix NEXT_PUBLIC_.
# Unused today; reserved for admin operations that bypass RLS.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Langflow — Flow → API / "Access" tab
# Base URL, no trailing slash. Cloud: https://api.langflow.astra.datastax.com/lf/<id>/api
LANGFLOW_URL=https://your-langflow-server.example.com
LANGFLOW_FLOW_ID=your_flow_id
LANGFLOW_API_KEY=your_langflow_api_key

# Optional, default "chat"
LANGFLOW_INPUT_TYPE=chat
LANGFLOW_OUTPUT_TYPE=chat

# App
# Public base URL; used for the Google OAuth callback and Supabase Auth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

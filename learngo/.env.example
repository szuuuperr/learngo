# LearnGo — Environment Variables
#
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# NEVER commit .env to version control.
# NOTE: this is a Next.js project — env vars use the NEXT_PUBLIC_ prefix for
# anything that must be reachable from the browser. Secrets stay server-side.

# ─────────────────────────────────────────────────────────────
# Supabase (Auth + Database + Realtime)
# Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public "anon" key. Safe to expose to the browser — access is controlled by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key. SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_.
# Used for admin ops that must bypass RLS (e.g. awarding XP reliably).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─────────────────────────────────────────────────────────────
# Langflow — AI Tutor (IBM Bob)
# Langflow UI → your Flow → API / "Access" tab
# ─────────────────────────────────────────────────────────────

# Base URL of the Langflow server, no trailing slash.
# Langflow Cloud uses https://api.langflow.astra.datastax.com/lf/xxxxx-your-id/api
LANGFLOW_URL=https://your-langflow-server.example.com

# The Flow ID this app talks to.
LANGFLOW_FLOW_ID=your_flow_id

# API key for the Langflow endpoint (x-api-key header).
LANGFLOW_API_KEY=your_langflow_api_key

# Optional. Langflow input/output types for this flow. Defaults to "chat".
LANGFLOW_INPUT_TYPE=chat
LANGFLOW_OUTPUT_TYPE=chat

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────

# Public base URL of this app. Used to build the Google OAuth callback URL.
# Dev must match the port Next.js runs on (default 3000).
# Also set as the Supabase Auth → Site URL / Redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LearnGo — Environment Variables
#
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# NEVER commit .env to version control.
#
# NOTE: this is a Next.js project. Only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser. Everything else stays server-side only.

# ─────────────────────────────────────────────────────────────
# Supabase — Auth + Database + Realtime
#
# Supabase Dashboard → Project Settings → API Keys
#
# New-style keys (prefix sb_publishable_ / sb_secret_) are used here.
# The legacy `anon` and `service_role` keys still work, but are deprecated.
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...). Safe to expose to the browser — every
# request is still filtered by the RLS policies in supabase/schema.sql.
# The NEXT_PUBLIC_ prefix is required for the browser bundle to see it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key (sb_secret_...). SERVER-SIDE ONLY. Never add a NEXT_PUBLIC_ prefix
# and never import it into a 'use client' file. Used for admin operations that
# must bypass RLS (awarding XP, granting badges).
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ─────────────────────────────────────────────────────────────
# Langflow — AI Tutor (IBM Bob)
# Langflow UI → your Flow → API / "Access" tab
# ─────────────────────────────────────────────────────────────

# Base URL of the Langflow server, no trailing slash.
# Langflow Cloud uses https://api.langflow.astra.datastax.com/lf/xxxxx-your-id/api
LANGFLOW_URL=https://your-langflow-server.example.com

# The Flow ID this app talks to.
LANGFLOW_FLOW_ID=your_flow_id

# API key for the Langflow endpoint (x-api-key header).
LANGFLOW_API_KEY=your_langflow_api_key

# Optional. Langflow input/output types for this flow. Defaults to "chat".
LANGFLOW_INPUT_TYPE=chat
LANGFLOW_OUTPUT_TYPE=chat

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────

# Public base URL of this app. Used to build the Google OAuth callback URL.
# Dev must match the port Next.js runs on (default 3000).
# Also set as the Supabase Auth → Site URL / Redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000